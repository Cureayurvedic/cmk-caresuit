# ─── CMK CareSuite Frontend Environment Example ───────────────────────────────
# Copy this file to .env.local and fill in real values.
# Never commit .env.local to version control.
#
# ⚠️  All variables MUST start with VITE_ to be exposed to the browser.
# ─────────────────────────────────────────────────────────────────────────────

# Full base URL of the backend API (no trailing slash)
# Development  : http://localhost:5000/api/v1
# Production   : https://api.yourdomain.com/api/v1
VITE_API_URL=http://localhost:5000/api/v1

# Application display name shown in titles / branding
VITE_APP_NAME=CMK CareSuite
